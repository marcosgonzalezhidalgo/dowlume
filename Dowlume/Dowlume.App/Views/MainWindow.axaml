<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Dowlume.App.ViewModels" xmlns:core="using:Dowlume.Core" x:Class="Dowlume.App.Views.MainWindow" x:DataType="vm:MainViewModel" x:CompileBindings="True" Title="Dowlume" Icon="/Assets/dowlume.ico" Width="1120" Height="820" MinWidth="880" MinHeight="680" Background="#F5F6FA" RequestedThemeVariant="Light">
  <Window.Styles>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#172137" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#5B6578" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="BorderBrush" Value="#E1E5ED" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#3456CF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Padding" Value="20,14" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto" Margin="28">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
      <StackPanel Spacing="5">
        <TextBlock Text="Dowlume" FontSize="32" FontWeight="Bold" Foreground="#172137" />
        <TextBlock Text="Your downloads, under control." Classes="muted" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="{Binding MonitoringLabel}" VerticalAlignment="Center" Classes="muted" />
        <Button Content="Pause" Command="{Binding PauseCommand}" IsEnabled="{Binding IsIdle}" IsVisible="{Binding IsMonitoring}" />
        <Button Content="Hide to tray" Click="OnHideToTray" />
      </StackPanel>
    </Grid>
    <TabControl Grid.Row="1">
      <TabItem Header="Overview">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,20,0,0">
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="Managed files" Classes="muted" />
                <TextBlock Text="{Binding ManagedCount}" FontSize="36" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="Awaiting your review" Classes="muted" />
                <TextBlock Text="{Binding ReviewCount}" FontSize="36" Foreground="#3456CF" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="Need attention" Classes="muted" />
                <TextBlock Text="{Binding AttentionCount}" FontSize="36" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </Grid>
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Categories}" Margin="0,20">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CategorySummary">
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding Category}" Classes="muted" />
                  <TextBlock Text="{Binding Count}" FontSize="22" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Grid.Row="2" Classes="card">
            <Grid RowDefinitions="Auto,*">
              <StackPanel Spacing="6" Margin="0,0,0,12">
                <TextBlock Text="Your organized files" Classes="heading" />
                <TextBlock Text="Start in Settings, then preview your folder. Files in review stay safe until you decide." TextWrapping="Wrap" Classes="muted" />
              </StackPanel>
              <ListBox Grid.Row="1" ItemsSource="{Binding ManagedFiles}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="core:TrackedFile">
                    <Grid ColumnDefinitions="*,120,100">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CurrentPath}" />
                      <TextBlock Grid.Column="1" Text="{Binding Category}" Classes="muted" />
                      <TextBlock Grid.Column="2" Text="{Binding Status}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Preview">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,20,0,0">
          <StackPanel Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="See what will change" Classes="heading" />
            <TextBlock Text="Preview checks completed files at the top of your chosen folder. Existing subfolders are left alone." TextWrapping="Wrap" Classes="muted" />
            <TextBlock Text="{Binding DownloadsPath}" TextWrapping="Wrap" />
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding PreviewItems}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:PreviewItem">
                <Grid ColumnDefinitions="*,*">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Destination}" Foreground="#3456CF" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,16,0,0" IsEnabled="{Binding CanConfigure}">
            <Button Content="Refresh preview" Command="{Binding PreviewCommand}" />
            <Button Content="Organize and monitor" Classes="primary" Command="{Binding StartCommand}" IsEnabled="{Binding HasPreview}" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Review">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,20,0,0">
          <StackPanel Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="A little space to decide" Classes="heading" />
            <TextBlock Text="Keep returns a file to its category permanently. Snooze returns it for 7 days. Nothing is deleted automatically." TextWrapping="Wrap" Classes="muted" />
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding ReviewFiles}" SelectedItem="{Binding SelectedReview}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:TrackedFile">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,120">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Category}" Classes="muted" />
                  </Grid>
                  <TextBlock Text="{Binding CurrentPath}" FontSize="12" TextTrimming="CharacterEllipsis" Classes="muted" />
                  <TextBlock Text="{Binding FirstSeenUtc, StringFormat='First tracked: {0:yyyy-MM-dd}'}" FontSize="12" Classes="muted" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,16,0,0" IsEnabled="{Binding IsIdle}">
            <Button Content="Keep" Command="{Binding KeepCommand}" Classes="primary" />
            <Button Content="Snooze 7 days" Command="{Binding SnoozeCommand}" />
            <Button Content="Move to…" Command="{Binding MoveCommand}" />
            <Button Content="Recycle…" Command="{Binding RecycleCommand}" />
            <Button Content="Show in Explorer" Command="{Binding RevealReviewCommand}" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Activity">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="0,20,0,0">
          <StackPanel Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="A clear record of every action" Classes="heading" />
            <TextBlock Text="Browse all recorded actions, newest first, across your saved folders. Select an action to inspect its paths." TextWrapping="Wrap" Classes="muted" />
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="*,140,155,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
            <TextBox Text="{Binding ActivitySearch}" PlaceholderText="Search filenames or paths" AutomationProperties.Name="Search activity filenames or paths">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SearchActivityCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <ComboBox Grid.Column="1" ItemsSource="{Binding ActivityKinds}" SelectedItem="{Binding SelectedActivityKind}" HorizontalAlignment="Stretch" AutomationProperties.Name="Filter activity by action" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding ActivityStatuses}" SelectedItem="{Binding SelectedActivityStatus}" HorizontalAlignment="Stretch" AutomationProperties.Name="Filter activity by status" />
            <Button Grid.Column="3" Content="Search / refresh" Command="{Binding SearchActivityCommand}" />
            <Button Grid.Column="4" Content="Clear" Command="{Binding ClearActivityFiltersCommand}" />
          </Grid>
          <ListBox Grid.Row="2" ItemsSource="{Binding Activity}" SelectedItem="{Binding SelectedOperation}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:OperationRecord">
                <Grid ColumnDefinitions="160,*,130">
                  <TextBlock Text="{Binding TimestampUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Classes="muted" />
                  <TextBlock Grid.Column="1" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Status}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="2" Text="No operations match. Try another search or clear the filters." IsVisible="{Binding IsActivityEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" />
          <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0" IsEnabled="{Binding IsIdle}">
            <Button Content="Previous" Command="{Binding PreviousActivityPageCommand}" IsEnabled="{Binding HasPreviousActivityPage}" />
            <TextBlock Grid.Column="1" Text="{Binding ActivityPageLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" />
            <Button Grid.Column="2" Content="Next" Command="{Binding NextActivityPageCommand}" IsEnabled="{Binding HasNextActivityPage}" />
          </Grid>
          <Border Grid.Row="4" Classes="card" Margin="0,12,0,0" Padding="12">
            <StackPanel Spacing="4">
              <SelectableTextBlock Text="{Binding SelectedOperation.SourcePath}" TextWrapping="Wrap" />
              <SelectableTextBlock Text="{Binding SelectedOperation.DestinationPath}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedOperation.Error}" TextWrapping="Wrap" Foreground="#9E361B" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0" IsEnabled="{Binding IsIdle}">
            <Button Content="Undo selected action…" Command="{Binding UndoCommand}" />
            <Button Content="Retry interrupted operations" Command="{Binding RetryRecoveryCommand}" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Settings">
        <ScrollViewer Margin="0,20,0,0">
          <StackPanel Spacing="18" IsEnabled="{Binding CanConfigure}">
            <TextBlock Text="Make room for your routine" Classes="heading" />
            <TextBlock Text="Pause monitoring to change these settings. Saved rules apply to future organization; existing categories are not rearranged." TextWrapping="Wrap" Classes="muted" />
            <StackPanel Spacing="8">
              <TextBlock Text="Downloads folder" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox Text="{Binding DownloadsPath}" PlaceholderText="Choose a local folder" />
                <Button Grid.Column="1" Content="Browse…" Command="{Binding ChooseFolderCommand}" />
              </Grid>
            </StackPanel>
            <Border Classes="card">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="110,150,*,110" ColumnSpacing="12">
                  <TextBlock Text="Category" />
                  <TextBlock Grid.Column="1" Text="Folder name" />
                  <TextBlock Grid.Column="2" Text="Extensions (comma separated)" />
                  <TextBlock Grid.Column="3" Text="Review days" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Rules}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryRuleViewModel">
                      <Grid ColumnDefinitions="110,150,*,110" ColumnSpacing="12" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Category}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding FolderName}" />
                        <TextBox Grid.Column="2" Text="{Binding Extensions}" />
                        <NumericUpDown Grid.Column="3" Value="{Binding ReviewAfterDays}" Minimum="1" Maximum="3650" FormatString="0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <StackPanel Spacing="8">
              <TextBlock Text="Excluded extensions" FontWeight="SemiBold" />
              <TextBox Text="{Binding ExcludedExtensions}" PlaceholderText="For example: .log, .bak" />
              <TextBlock Text="Browser partial downloads are always excluded. Unrecognized extensions go to Other." Classes="muted" />
            </StackPanel>
            <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Classes="primary" />
            <TextBlock Text="Local only. No account, cloud sync, or telemetry. Closing the window stops monitoring; Hide to tray keeps it running." TextWrapping="Wrap" Classes="muted" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Spacing="7" Margin="0,18,0,0">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Classes="muted" />
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#9E361B" />
    </StackPanel>
  </Grid>
</Window>
